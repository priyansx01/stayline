// Stayline VPN window: dark sidebar navigation, light content with rounded panels.

import { AboutSlint, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct Component {
    name: string,
    version: string,
    license: string,
}

export global Theme {
    in-out property <bool> dark: false;

    out property <color> sidebar: dark ? #13162a : #1f2340;
    out property <color> sidebar-text: #a3a8c3;
    out property <color> page: dark ? #0f1220 : #f3f4f9;
    out property <color> panel: dark ? #191d31 : #ffffff;
    out property <color> panel-alt: dark ? #20253c : #f5f6fb;
    out property <color> border: dark ? #2a2f48 : #e6e8f0;
    out property <color> border-strong: dark ? #3a4060 : #cfd3e1;
    out property <color> text: dark ? #e9ebf5 : #1d2033;
    out property <color> muted: dark ? #8d92ad : #858aa3;
    out property <color> accent: #2f7bff;
    out property <color> accent-soft: dark ? #2f7bff33 : #2f7bff17;
    out property <color> success: #22c55e;
    out property <color> warning: #f59e0b;
    out property <color> danger: #ef4444;
    out property <color> danger-soft: dark ? #ef444429 : #ef444414;
    out property <color> shadow: dark ? #00000000 : #1f23400d;

    // 0 = off, 1 = busy, 2 = on, 3 = needs attention
    public pure function state-color(kind: int) -> color {
        kind == 2 ? success : kind == 1 ? warning : kind == 3 ? danger : muted
    }
}

component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;
}

component Caption inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Theme.muted;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component NavRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 36px;
    border-radius: 10px;
    background: active ? #ffffff14 : touch.has-hover ? #ffffff0a : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    if root.active: Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 11px;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.active ? Theme.accent : Theme.sidebar-text;
            }
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? #ffffff : Theme.sidebar-text;
            vertical-alignment: center;
        }
    }
}

// kind: 0 = primary, 1 = secondary, 2 = danger, 3 = text
component Button inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    callback clicked;

    property <color> base: kind == 0 ? Theme.accent : kind == 2 ? Theme.danger : kind == 1 ? Theme.panel-alt : transparent;
    property <color> label-color: kind == 0 || kind == 2 ? #ffffff : kind == 3 ? Theme.accent : Theme.text;

    height: 32px;
    border-radius: 9px;
    border-width: kind == 1 ? 1px : 0px;
    border-color: Theme.border;
    background: !enabled ? base : touch.pressed ? base.darker(0.14) : touch.has-hover ? (kind == 3 ? Theme.accent-soft : base.darker(0.07)) : base;
    opacity: enabled ? 1 : 0.45;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: root.kind == 3 ? 8px : 14px;
        padding-right: root.kind == 3 ? 8px : 14px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: root.label-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> hint;
    in property <bool> password;
    in property <bool> read-only;
    in property <bool> mono;
    callback edited(string);
    callback accepted(string);

    property <bool> reveal;
    spacing: 4px;

    if root.label != "": Caption {
        text: root.label;
    }

    Rectangle {
        height: 32px;
        // The placeholder's width follows the box, not the other way round.
        min-width: 0px;
        border-radius: 8px;
        background: root.read-only ? Theme.panel-alt : Theme.panel;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 6px;

            input := TextInput {
                text <=> root.text;
                read-only: root.read-only;
                single-line: true;
                font-size: root.mono ? 11px : 12px;
                font-family: root.mono ? "Consolas" : "Segoe UI";
                color: Theme.text;
                selection-background-color: Theme.accent-soft;
                vertical-alignment: center;
                input-type: root.password && !root.reveal ? InputType.password : InputType.text;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
            }

            if root.password: VerticalLayout {
                alignment: center;
                Image {
                    source: root.reveal ? @image-url("icons/visibility_off.svg") : @image-url("icons/visibility.svg");
                    width: 15px;
                    height: 15px;
                    colorize: Theme.muted;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reveal = !root.reveal;
                        }
                    }
                }
            }
        }

        if root.text == "" && root.placeholder != "": Text {
            x: 11px;
            // Stops before the eye icon instead of running under it.
            width: parent.width - self.x - (root.password ? 32px : 10px);
            height: parent.height;
            overflow: elide;
            text: root.placeholder;
            font-size: 12px;
            color: Theme.muted.with-alpha(0.75);
            vertical-alignment: center;
        }
    }

    if root.hint != "": Text {
        text: root.hint;
        font-size: 11px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled;

    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.accent : Theme.border-strong;
    animate background { duration: 120ms; }

    Rectangle {
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        animate x {
            duration: 120ms;
            easing: ease-out;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component StatusDot inherits Rectangle {
    in property <int> kind;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: Theme.state-color(kind).with-alpha(0.14);

    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.state-color(root.kind);
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> dot;
    height: 24px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        Text {
            text: root.text;
            font-size: 11px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

component StatTile inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <string> caption;

    border-radius: 14px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: Theme.shadow;
    min-height: 82px;
    min-width: 0px;
    preferred-width: 100px;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                colorize: Theme.accent;
            }
        }
        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.caption;
            font-size: 11px;
            color: Theme.muted;
            horizontal-alignment: center;
        }
    }
}

component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> error: true;

    border-radius: 10px;
    background: error ? Theme.danger-soft : Theme.accent-soft;

    HorizontalLayout {
        padding: 10px;
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: 12px;
            color: root.error ? Theme.danger : Theme.text;
        }
    }
}

component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <string> placeholder: "Choose a profile";
    callback selected(int);

    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    opacity: enabled ? 1 : 0.55;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.placeholder;
            font-size: 12px;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "▾";
            font-size: 11px;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;

        Rectangle {
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000026;

            VerticalLayout {
                padding: 4px;
                for item[i] in root.model: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: i == root.current-index ? Theme.accent-soft : row.has-hover ? Theme.panel-alt : transparent;
                    Text {
                        x: 8px;
                        height: parent.height;
                        text: item;
                        font-size: 12px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    row := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback changed(int);

    height: 30px;
    border-radius: 9px;
    background: Theme.panel-alt;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 7px;
            background: i == root.current ? Theme.panel : transparent;
            drop-shadow-blur: i == root.current ? 4px : 0px;
            drop-shadow-color: #0000001a;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: item;
                    font-size: 11px;
                    font-weight: i == root.current ? 600 : 400;
                    color: i == root.current ? Theme.text : Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 16px;
    padding-top: 12px;
    padding-bottom: 12px;

    VerticalLayout {
        spacing: 2px;
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 11px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text {
        text: root.label;
        width: 90px;
        font-size: 12px;
        color: Theme.muted;
    }
    Text {
        text: root.value != "" ? root.value : "–";
        font-size: 12px;
        color: Theme.text;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

export component AppWindow inherits Window {
    title: "Stayline VPN";
    icon: @image-url("icons/stayline-icon-32.png");
    background: Theme.page;
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    min-width: 760px;
    min-height: 500px;
    preferred-width: 840px;
    preferred-height: 560px;

    in property <string> version;

    // Appearance: theme-mode 0 = Light, 1 = Dark, 2 = System
    in-out property <bool> is-dark <=> Theme.dark;
    in-out property <int> theme-mode: 2;

    // 0 = Status, 1 = Profiles, 2 = Settings, 3 = About
    in-out property <int> current-tab: 0;

    // Connections
    in property <[string]> connection-names;
    in property <[StandardListViewItem]> connection-items;
    in-out property <int> active-index;
    in-out property <int> selected-index;

    // Status
    in property <int> state-kind;
    in property <string> state-title: "Disconnected";
    in property <string> state-detail;
    in property <string> gateway-display;
    in property <string> tunnel-ip;
    in property <string> connected-for;
    in property <string> sent;
    in property <string> received;
    in property <bool> can-connect;
    in property <bool> can-disconnect;
    in property <bool> needs-attention;

    // 0 = none, 1 = first connection (may trust), 2 = certificate changed
    in property <int> trust-mode;
    in property <string> trust-gateway;
    in property <string> trust-fingerprint;

    // Profile form
    in-out property <string> conn-name;
    in-out property <string> gateway;
    in-out property <string> gateway-host;
    in-out property <string> gateway-port;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> realm;
    in-out property <string> pin;
    in-out property <bool> save-password: true;
    in property <bool> password-saved;
    in property <bool> conn-managed;
    in property <bool> realm-locked;
    in property <bool> can-add: true;
    in property <bool> can-remove;
    in property <string> form-error;
    in property <string> form-info;
    in-out property <bool> password-visible;
    in-out property <bool> confirm-delete-open;

    // Sign-in prompt shown when connecting without a saved password
    in-out property <bool> password-prompt-open;
    in property <string> prompt-title;
    in property <string> prompt-detail;
    in-out property <string> prompt-password;
    in-out property <bool> prompt-remember: true;
    in property <string> prompt-error;

    // Certificate check
    in property <bool> cert-checking;
    in property <string> cert-result;
    in property <string> cert-fingerprint;
    in property <bool> cert-public;

    // Settings
    in-out property <bool> auto-connect;
    in-out property <bool> start-at-login;
    in property <string> service-status;

    // About
    in property <[Component]> components;
    in-out property <string> search-query;

    callback connect();
    callback disconnect();
    callback cancel-connect();
    callback choose-active(int);
    callback trust-and-connect();
    callback dismiss-trust();
    callback select-connection(int);
    callback add-connection();
    callback remove-connection();
    callback request-delete-connection();
    callback cancel-delete-connection();
    callback save-settings();
    callback save-and-connect();
    callback check-certificate();
    callback trust-certificate();
    callback preferences-changed();
    callback theme-changed(int);
    callback open-logs();
    callback open-notices();
    callback filter-components(string);
    callback prompt-connect();
    callback prompt-cancel();

    property <bool> service-running: root.service-status == "Running";

    // Keep the standard widgets (scroll bars, Slint badge) in the app's theme
    // rather than Windows' own light/dark setting.
    init => {
        Palette.color-scheme = root.is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed is-dark => {
        Palette.color-scheme = root.is-dark ? ColorScheme.dark : ColorScheme.light;
    }

    HorizontalLayout {
        // ---- Sidebar ----
        Rectangle {
            width: 196px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 16px;
                padding-top: 22px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 10px;
                    padding-left: 6px;
                    padding-bottom: 22px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("icons/stayline-logo.svg");
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: "Stayline VPN";
                        font-size: 16px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }

                NavRow {
                    icon: @image-url("icons/activity.svg");
                    text: "Status";
                    active: root.current-tab == 0;
                    clicked => {
                        root.current-tab = 0;
                    }
                }
                NavRow {
                    icon: @image-url("icons/lan.svg");
                    text: "Profiles";
                    active: root.current-tab == 1;
                    clicked => {
                        root.current-tab = 1;
                    }
                }
                NavRow {
                    icon: @image-url("icons/tune.svg");
                    text: "Settings";
                    active: root.current-tab == 2;
                    clicked => {
                        root.current-tab = 2;
                    }
                }
                NavRow {
                    icon: @image-url("icons/info.svg");
                    text: "About";
                    active: root.current-tab == 3;
                    clicked => {
                        root.current-tab = 3;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: root.service-running ? Theme.success : Theme.danger;
                        }
                    }
                    Text {
                        text: root.service-running ? "Service running" : root.service-status == "Not installed" ? "Service not installed" : root.service-status == "Starting" ? "Starting service…" : "Service not running";
                        font-size: 11px;
                        color: Theme.sidebar-text;
                        vertical-alignment: center;
                    }
                }
                // Lines up with the service text, past the dot (8 + 7 + 8).
                HorizontalLayout {
                    padding-left: 23px;
                    Text {
                        text: "Version " + root.version;
                        font-size: 10px;
                        color: Theme.sidebar-text.with-alpha(0.6);
                    }
                }
            }
        }

        // ---- Content ----
        VerticalLayout {
            padding: 20px;
            padding-top: 18px;
            spacing: 14px;
            horizontal-stretch: 1;

            // Page header
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.current-tab == 0 ? "Status" : root.current-tab == 1 ? "Profiles" : root.current-tab == 2 ? "Settings" : "About";
                        font-size: 18px;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: root.current-tab == 0 ? "Your VPN connection at a glance" : root.current-tab == 1 ? "Gateways and sign-in details" : root.current-tab == 2 ? "Startup, appearance and troubleshooting" : "Version, licences and credits";
                        font-size: 11px;
                        color: Theme.muted;
                    }
                }
            }

            // ---- Status ----
            if root.current-tab == 0: VerticalLayout {
                spacing: 14px;
                alignment: start;
                vertical-stretch: 1;

                Panel {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 14px;
                            StatusDot {
                                kind: root.state-kind;
                            }
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.state-title;
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.state-detail;
                                    font-size: 12px;
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.state-kind == 1: Button {
                                        text: "Cancel";
                                        kind: 1;
                                        clicked => {
                                            root.cancel-connect();
                                        }
                                    }
                                    if root.can-disconnect: Button {
                                        text: "Disconnect";
                                        kind: 1;
                                        clicked => {
                                            root.disconnect();
                                        }
                                    }
                                    if !root.can-disconnect: Button {
                                        text: "Connect";
                                        enabled: root.can-connect && root.connection-names.length > 0;
                                        clicked => {
                                            root.connect();
                                        }
                                    }
                                }
                            }
                        }

                        if root.trust-mode == 2: Rectangle {
                            border-radius: 10px;
                            background: Theme.danger-soft;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                Text {
                                    text: "The gateway's certificate has changed";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.danger;
                                }
                                Text {
                                    text: "This can mean someone is intercepting your connection. Stayline VPN will not connect. Contact your IT department.";
                                    font-size: 11px;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.trust-fingerprint;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.needs-attention && root.trust-mode == 0: Banner {
                            text: "Stayline VPN stopped retrying because something needs your attention. Check the profile, then connect again.";
                        }

                        Divider { }

                        HorizontalLayout {
                            spacing: 12px;
                            Caption {
                                text: "PROFILE";
                                vertical-alignment: center;
                                width: 60px;
                            }
                            if root.connection-names.length > 0: Select {
                                model: root.connection-names;
                                current-index <=> root.active-index;
                                enabled: root.can-connect;
                                selected(index) => {
                                    root.choose-active(index);
                                }
                            }
                            if root.connection-names.length == 0: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "No profile yet.";
                                    font-size: 12px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Add a profile";
                                    kind: 3;
                                    clicked => {
                                        root.current-tab = 1;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        InfoRow {
                            label: "Gateway";
                            value: root.gateway-display;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    StatTile {
                        icon: @image-url("icons/schedule.svg");
                        value: root.connected-for;
                        caption: "Connected for";
                    }
                    StatTile {
                        icon: @image-url("icons/lan.svg");
                        value: root.tunnel-ip;
                        caption: "Tunnel address";
                    }
                    StatTile {
                        icon: @image-url("icons/arrow_up.svg");
                        value: root.sent;
                        caption: "Sent";
                    }
                    StatTile {
                        icon: @image-url("icons/arrow_down.svg");
                        value: root.received;
                        caption: "Received";
                    }
                }
            }

            // ---- Profiles ----
            if root.current-tab == 1: HorizontalLayout {
                spacing: 14px;
                vertical-stretch: 1;

                Panel {
                    width: 210px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;

                        Caption {
                            text: "SAVED PROFILES";
                            height: 22px;
                            x: 6px;
                        }

                        if root.connection-items.length == 0: Text {
                            text: "No profiles yet.";
                            font-size: 12px;
                            color: Theme.muted;
                            x: 6px;
                        }

                        for item[index] in root.connection-items: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: index == root.selected-index ? Theme.accent-soft : row.has-hover ? Theme.panel-alt : transparent;

                            row := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.select-connection(index);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/lan.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: index == root.selected-index ? Theme.accent : Theme.muted;
                                    }
                                }
                                Text {
                                    text: item.text;
                                    font-size: 12px;
                                    font-weight: index == root.selected-index ? 600 : 400;
                                    color: index == root.selected-index ? Theme.accent : Theme.text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        if root.can-add: HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "Add";
                                kind: 1;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.add-connection();
                                }
                            }
                            Button {
                                text: "Delete";
                                kind: 1;
                                enabled: root.can-remove;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.request-delete-connection();
                                }
                            }
                        }
                        if !root.can-add: Text {
                            text: "Profiles are set up by your IT department. Contact IT if you need a different one.";
                            font-size: 11px;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }

                Panel {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                alignment: start;

                                if root.form-error != "": Banner {
                                    text: root.form-error;
                                }
                                if root.form-info != "": Banner {
                                    text: root.form-info;
                                    error: false;
                                }

                                Caption {
                                    text: "CONNECTION";
                                }
                                if root.conn-managed: VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Set up by your organisation. Only your username and password can be changed.";
                                        font-size: 11px;
                                        color: Theme.muted;
                                        wrap: word-wrap;
                                    }
                                    InfoRow {
                                        label: "Name";
                                        value: root.conn-name;
                                    }
                                    InfoRow {
                                        label: "Address";
                                        value: root.gateway-host;
                                    }
                                    InfoRow {
                                        label: "Port";
                                        value: root.gateway-port != "" ? root.gateway-port : "443";
                                    }
                                    InfoRow {
                                        label: "Certificate";
                                        value: root.pin != "" ? "Pinned by your organisation" : "Public, or confirmed on first connect";
                                    }
                                }
                                if !root.conn-managed: Field {
                                    label: "Name";
                                    text <=> root.conn-name;
                                    placeholder: "Office VPN";
                                }
                                if !root.conn-managed: HorizontalLayout {
                                    spacing: 12px;
                                    Field {
                                        label: "Gateway address";
                                        text <=> root.gateway-host;
                                        placeholder: "vpn.example.com or 203.0.113.10";
                                        horizontal-stretch: 1;
                                    }
                                    Field {
                                        label: "Port";
                                        text <=> root.gateway-port;
                                        placeholder: "443";
                                        width: 96px;
                                    }
                                }

                                Divider { }
                                Caption {
                                    text: "SIGN-IN";
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Field {
                                        label: "Username";
                                        text <=> root.username;
                                        horizontal-stretch: 1;
                                    }
                                    Field {
                                        label: "Password";
                                        text <=> root.password;
                                        password: true;
                                        placeholder: root.password-saved ? "Saved" : "";
                                        horizontal-stretch: 1;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Save password for this Windows account";
                                        font-size: 12px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Toggle {
                                        checked <=> root.save-password;
                                    }
                                }
                                Field {
                                    label: "Realm (optional)";
                                    text <=> root.realm;
                                    read-only: root.realm-locked;
                                    hint: "Only needed if your IT department gave you one.";
                                }

                                if !root.conn-managed: Divider { }
                                if !root.conn-managed: Caption {
                                    text: "CERTIFICATE";
                                }
                                if !root.conn-managed: Field {
                                    label: "SHA-256 fingerprint";
                                    text <=> root.pin;
                                    mono: true;
                                    placeholder: "Leave empty to confirm on first connect";
                                }
                                if !root.conn-managed: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: root.cert-checking ? "Checking…" : "Check certificate";
                                        kind: 1;
                                        enabled: !root.cert-checking && root.gateway-host != "";
                                        clicked => {
                                            root.check-certificate();
                                        }
                                    }
                                    if root.cert-fingerprint != "" && !root.cert-public && root.cert-fingerprint != root.pin: Button {
                                        text: "Trust this certificate";
                                        kind: 3;
                                        clicked => {
                                            root.trust-certificate();
                                        }
                                    }
                                }
                                if !root.conn-managed && root.cert-result != "": Text {
                                    text: root.cert-result;
                                    font-size: 11px;
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Divider { }
                        HorizontalLayout {
                            padding: 12px;
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Save";
                                kind: 1;
                                clicked => {
                                    root.save-settings();
                                }
                            }
                            Button {
                                text: "Save and connect";
                                clicked => {
                                    root.save-and-connect();
                                }
                            }
                        }
                    }
                }
            }

            // ---- Settings ----
            if root.current-tab == 2: VerticalLayout {
                spacing: 14px;
                alignment: start;
                vertical-stretch: 1;

                Panel {
                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        SettingRow {
                            title: "Connect automatically";
                            description: "Connect when Stayline VPN starts, if a password is saved.";
                            Toggle {
                                checked <=> root.auto-connect;
                                toggled => {
                                    root.preferences-changed();
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: "Start with Windows";
                            description: "Open Stayline VPN in the tray when you sign in.";
                            Toggle {
                                checked <=> root.start-at-login;
                                toggled => {
                                    root.preferences-changed();
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: "Appearance";
                            description: "Light, dark, or follow Windows.";
                            Segmented {
                                items: ["Light", "Dark", "System"];
                                current <=> root.theme-mode;
                                changed(index) => {
                                    root.theme-changed(index);
                                }
                            }
                        }
                    }
                }

                Panel {
                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        SettingRow {
                            title: "Background service";
                            description: root.service-running ? "Running. The VPN stays up even when this window is closed." : root.service-status == "Not installed" ? "Not installed. Reinstall Stayline VPN or contact IT." : root.service-status == "Starting" ? "Starting…" : "Not running, so the VPN cannot connect. Restart the computer or contact IT.";
                            Chip {
                                text: root.service-status;
                                dot: root.service-running ? Theme.success : Theme.danger;
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: "Logs";
                            description: "Useful when IT asks for details about a problem.";
                            Button {
                                text: "Open logs folder";
                                kind: 1;
                                clicked => {
                                    root.open-logs();
                                }
                            }
                        }
                    }
                }
            }

            // ---- About ----
            if root.current-tab == 3: VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;

                Panel {
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 14px;
                        Rectangle {
                            width: 52px;
                            height: 52px;
                            border-radius: 12px;
                            background: Theme.panel-alt;
                            Image {
                                source: @image-url("icons/stayline-logo.svg");
                                width: 36px;
                                height: 36px;
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Stayline VPN";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "v" + root.version;
                                    font-size: 11px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Keeps your FortiGate SSL-VPN connection up and reconnects it automatically.";
                                font-size: 12px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Not affiliated with or endorsed by Fortinet, Inc. FortiGate and FortiClient are trademarks of Fortinet, Inc. Protocol behaviour learned from openfortivpn; no openfortivpn code is included.";
                                font-size: 10px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            AboutSlint { }
                        }
                    }
                }

                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Open-source components (" + root.components.length + ")";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: "Stayline VPN is built on the software below. Thank you to all its authors.";
                                    font-size: 11px;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                            }
                            Field {
                                width: 170px;
                                text <=> root.search-query;
                                placeholder: "Search";
                                edited(query) => {
                                    root.filter-components(query);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Licence texts";
                                    kind: 1;
                                    clicked => {
                                        root.open-notices();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: Theme.panel-alt;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Caption {
                                    text: "COMPONENT";
                                    width: 200px;
                                    vertical-alignment: center;
                                }
                                Caption {
                                    text: "VERSION";
                                    width: 70px;
                                    vertical-alignment: center;
                                }
                                Caption {
                                    text: "LICENCE";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            min-height: 80px;
                            for component in root.components: HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                height: 24px;
                                Text {
                                    text: component.name;
                                    width: 200px;
                                    font-size: 11px;
                                    color: Theme.text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: component.version;
                                    width: 70px;
                                    font-size: 11px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: component.license;
                                    font-size: 11px;
                                    color: Theme.muted;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Delete confirmation
    if root.confirm-delete-open: Rectangle {
        background: #0000007a;
        TouchArea { }

        Panel {
            width: 340px;
            height: dialog.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            dialog := VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text {
                    text: "Remove profile?";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: "\"" + root.conn-name + "\" and its saved password will be removed.";
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        kind: 1;
                        clicked => {
                            root.cancel-delete-connection();
                        }
                    }
                    Button {
                        text: "Remove";
                        kind: 2;
                        clicked => {
                            root.remove-connection();
                        }
                    }
                }
            }
        }
    }

    // Sign-in prompt
    if root.password-prompt-open: Rectangle {
        background: #0000007a;
        TouchArea { }

        Panel {
            width: 360px;
            height: prompt.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            prompt := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: root.prompt-title;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.prompt-detail;
                        font-size: 11px;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
                if root.prompt-error != "": Banner {
                    text: root.prompt-error;
                }
                Field {
                    label: "Password";
                    text <=> root.prompt-password;
                    password: true;
                    accepted => {
                        root.prompt-connect();
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Save password for this Windows account";
                        font-size: 12px;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Toggle {
                        checked <=> root.prompt-remember;
                    }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        kind: 1;
                        clicked => {
                            root.prompt-cancel();
                        }
                    }
                    Button {
                        text: "Connect";
                        enabled: root.prompt-password != "";
                        clicked => {
                            root.prompt-connect();
                        }
                    }
                }
            }
        }
    }

    // First connection to a gateway whose certificate needs approval
    if root.trust-mode == 1: Rectangle {
        background: #0000007a;
        TouchArea { }

        Panel {
            width: 440px;
            height: trust.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            trust := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.warning.with-alpha(0.15);
                        Text {
                            text: "!";
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.warning;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Text {
                            text: "Trust this gateway?";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: "First connection to " + root.trust-gateway;
                            font-size: 11px;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                }
                Text {
                    text: "The gateway's certificate is not issued by a public authority. Check that this fingerprint matches the one from your IT department. Stayline VPN will remember it and warn you if it ever changes.";
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 6px;
                    Caption {
                        text: "SHA-256 FINGERPRINT";
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.page;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.trust-fingerprint;
                                font-family: "Consolas";
                                font-size: 11px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Deny";
                        kind: 1;
                        clicked => {
                            root.dismiss-trust();
                        }
                    }
                    Button {
                        text: "Trust and connect";
                        clicked => {
                            root.trust-and-connect();
                        }
                    }
                }
            }
        }
    }
}
